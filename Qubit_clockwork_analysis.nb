Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fmerit", "[", 
    RowBox[{"een_", ",", "pphi_"}], "]"}], "=", 
   RowBox[{"figmerit", "  ", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"En", "->", "een"}], ",", 
      RowBox[{"Phi", "->", "pphi"}]}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"p1", "=", 
  RowBox[{"Plot3D", "[", 
   RowBox[{
    RowBox[{"fmerit", "[", 
     RowBox[{"x", ",", "y"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "2.5"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", "0", ",", 
      RowBox[{"2", "*", "Pi"}]}], "}"}], ",", 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1.20"}], "}"}]}], ",", 
    RowBox[{"PlotPoints", "->", "400"}], ",", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ToExpression", "[", 
        RowBox[{"\"\<\\\\Delta\>\"", ",", "TeXForm", ",", "HoldForm"}], "]"}],
        ",", 
       RowBox[{"ToExpression", "[", 
        RowBox[{"\"\<\\\\phi\>\"", ",", "TeXForm", ",", "HoldForm"}], "]"}], 
       ",", 
       RowBox[{"ToExpression", "[", 
        RowBox[{
        "\"\<\\\\text{SNR}/\\\\Gamma\>\"", ",", "TeXForm", ",", "HoldForm"}], 
        "]"}]}], "}"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{"\"\<SNR_qubit_clockwork.eps\>\"", ",", "p1"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{"\"\<SNR_qubit_clockwork.png\>\"", ",", "p1"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"optimizedfmerit", "=", 
   RowBox[{"Maximize", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"fmerit", "[", 
        RowBox[{"En", ",", "Phi"}], "]"}], ",", 
       RowBox[{"2", ">=", "En", ">=", "0.1"}], ",", 
       RowBox[{"0.1", "<=", "Phi", "<=", 
        RowBox[{"1.9", " ", "Pi"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"En", ",", "Phi"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"optimizedSNR", " ", "=", 
   RowBox[{"optimizedfmerit", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"optimizedEn", " ", "=", " ", 
   RowBox[{"En", "/.", " ", 
    RowBox[{"optimizedfmerit", "[", 
     RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"optimizedPhi", " ", "=", " ", 
   RowBox[{"Phi", "/.", " ", 
    RowBox[{"optimizedfmerit", "[", 
     RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"optimizedPhi", "=", 
   RowBox[{"optimizedPhi", "/", "Pi"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{
   RowBox[{"OutputForm", "[", "\"\<The optimal SNR of \>\"", "]"}], ",", 
