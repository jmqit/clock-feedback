In[95]:=",ExpressionUUID->"80cece42-e2c2-4a0e-a172-6ccd7956b05f"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"SNR=\"\>", "\[InvisibleSpace]", 
   FractionBox[
    RowBox[{"4", " ", 
     SuperscriptBox["En", "2"], " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"4", " ", 
        SuperscriptBox["En", "2"]}], "-", 
       RowBox[{"Cos", "[", "Phi", "]"}], "-", 
       RowBox[{"2", " ", "En", " ", 
        RowBox[{"Sin", "[", "Phi", "]"}]}]}], ")"}]}], 
    RowBox[{"5", "-", 
     RowBox[{"4", " ", 
      SuperscriptBox["En", "2"]}], "+", 
     RowBox[{"32", " ", 
      SuperscriptBox["En", "4"]}], "+", 
     RowBox[{"4", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{"4", " ", 
         SuperscriptBox["En", "2"]}]}], ")"}], " ", 
      RowBox[{"Cos", "[", "Phi", "]"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{"4", " ", 
         SuperscriptBox["En", "2"]}]}], ")"}], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"2", " ", "Phi"}], "]"}]}], "-", 
     RowBox[{"8", " ", "En", " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"Cos", "[", "Phi", "]"}]}], ")"}], " ", 
      RowBox[{"Sin", "[", "Phi", "]"}]}]}]]}],
  SequenceForm[
  "SNR=", 4 $CellContext`En^2 (1 + 4 $CellContext`En^2 - 
    Cos[$CellContext`Phi] - 2 $CellContext`En Sin[$CellContext`Phi])/(5 - 
   4 $CellContext`En^2 + 32 $CellContext`En^4 + 
   4 (-1 + 4 $CellContext`En^2) 
    Cos[$CellContext`Phi] + (-1 + 4 $CellContext`En^2) 
    Cos[2 $CellContext`Phi] - 8 $CellContext`En (1 + Cos[$CellContext`Phi]) 
   Sin[$CellContext`Phi])],
  Editable->False]], "Print",
 CellChangeTimes->{3.9805304919467025`*^9, 3.980530612227928*^9, 
